DATABASE_URL="postgresql://postgres:admin123@localhost:5432/wooftools"
PORT=8000

# GoPlus Security API (https://docs.gopluslabs.io)
GOPLUS_API_BASE="https://api.gopluslabs.io/api/v1"
# App credentials from https://gopluslabs.io (free tier). Used to mint the access token
# for the Transaction Simulation API. Token/Approval Security work without auth.
GOPLUS_APP_KEY=""
GOPLUS_APP_SECRET=""
# Access token minted via POST /api/v1/token (Bearer for /transaction_simulation).
GOPLUS_ACCESS_TOKEN=""

# Likes: max times a single wallet can like the same entity (default 20).
MAX_LIKES_PER_WALLET_PER_ENTITY=20
