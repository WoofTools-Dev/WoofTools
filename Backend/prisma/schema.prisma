// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DailyWinner {
  id               Int      @id @default(autoincrement())
  username         String
  date             DateTime @default(now())
  walletAddress    String? // Optional wallet address for the winner
  price            Float? // Single price associated with the winner
  previousPrices   Float[] // Array of previous prices
  previousTimes    Float[] // Unix timestamps (seconds) for each previous price
  growthPercentage Float? // Growth percentage for the winner
  chain            String   @default("ethereum")
  chainId          Int      @default(1)
  source           String   @default("seed")
  lastSyncedAt     DateTime?
  updatedAt        DateTime @updatedAt
  isVisible        Boolean  @default(true)
  isPinned         Boolean  @default(false)
  displayOrder     Int      @default(0)

  @@unique([chainId, date, username])
  @@index([chainId, isVisible])
}

model DailyLoser {
  id               Int      @id @default(autoincrement())
  username         String
  date             DateTime @default(now())
  walletAddress    String? // Optional wallet address for the loser
  price            Float? // Single price associated with the loser
  previousPrices   Float[] // Array of previous prices
  previousTimes    Float[] // Unix timestamps (seconds) for each previous price
  growthPercentage Float? // Growth percentage for the loser
  chain            String   @default("ethereum")
  chainId          Int      @default(1)
  source           String   @default("seed")
  lastSyncedAt     DateTime?
  updatedAt        DateTime @updatedAt
  isVisible        Boolean  @default(true)
  isPinned         Boolean  @default(false)
  displayOrder     Int      @default(0)

  @@unique([chainId, date, username])
  @@index([chainId, isVisible])
}

model UpdatedRRSS {
  id               Int      @id @default(autoincrement())
  profileName      String
  lastUpdated      DateTime @default(now())
  walletAddress    String? // Optional wallet address for the RRSS
  price            Float? // Single price associated with the RRSS
  previousPrices   Float[] // Array of previous prices
  previousTimes    Float[] // Unix timestamps (seconds) for each previous price
  growthPercentage Float? // Growth percentage for the RRSS
  chain            String   @default("ethereum")
  chainId          Int      @default(1)
  source           String   @default("seed")
  lastSyncedAt     DateTime?
  updatedAt        DateTime @updatedAt
  isVisible        Boolean  @default(true)
  isPinned         Boolean  @default(false)
  displayOrder     Int      @default(0)

  @@unique([chainId, profileName])
  @@index([chainId, isVisible])
}

model HotPair {
  id               Int      @id @default(autoincrement())
  pairName         String
  popularity       Int      @default(0) // like counter, starts at 0
  walletAddress    String? // Optional wallet address for the pair
  price            Float? // Single price associated with the pair
  previousPrices   Float[] // Array of previous prices
  previousTimes    Float[] // Unix timestamps (seconds) for each previous price
  growthPercentage Float? // Growth percentage for the pair
  chain            String   @default("ethereum")
  chainId          Int      @default(1)
  source           String   @default("seed")
  lastSyncedAt     DateTime?
  updatedAt        DateTime @updatedAt
  isVisible        Boolean  @default(true)
  isPinned         Boolean  @default(false)
  displayOrder     Int      @default(0)

  @@unique([chainId, pairName])
  @@index([chainId, isVisible])
}

model DashboardData {
  id             Int      @id @default(autoincrement())
  token0Name     String
  token1Name     String
  pairAddress    String
  price          Float
  percentage24H  Float
  score          Int      @default(0) // like counter, starts at 0
  contracts      String
  created        DateTime
  volume         String
  swaps          String
  liquidity      String
  marketCap      String
  volumeNumeric  Decimal?
  swapsNumeric   Int?
  liquidityNumeric Decimal?
  marketCapNumeric Decimal?
  dex            String[]
  chain          String   @default("ethereum")
  chainId        Int      @default(1)
  source         String   @default("seed")
  lastSyncedAt   DateTime?
  updatedAt      DateTime @updatedAt
  isVisible      Boolean  @default(true)
  isPinned       Boolean  @default(false)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([chainId, pairAddress])
  @@index([chainId, isVisible])
}

model LivePair {
  id               Int      @id @default(autoincrement())
  token0Name       String
  token1Name       String
  pairAddress      String
  listedSince      DateTime
  tokenPriceUSD    Float
  initialLiquidity String
  totalLiquidity   String
  poolAmount       String
  poolVariation    Float
  poolRemaining    String
  contract         String
  chain            String   @default("ethereum")
  chainId          Int      @default(1)
  source           String   @default("seed")
  lastSyncedAt     DateTime?
  updatedAt        DateTime @updatedAt
  isVisible        Boolean  @default(true)
  isPinned         Boolean  @default(false)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([chainId, pairAddress])
  @@index([chainId, isVisible])
}

model SwapTransaction {
  id            Int      @id @default(autoincrement())
  token0Name    String
  token1Name    String
  pairAddress   String
  executionTime DateTime
  type          String
  quantity      Float
  totalETH      Float
  totalUSD      Float
  variation     Float
  maker         String
  txHash        String?
  chain         String   @default("ethereum")
  chainId       Int      @default(1)
  source        String   @default("seed")
  lastSyncedAt  DateTime?
  updatedAt     DateTime @updatedAt
  isVisible     Boolean  @default(true)
  isPinned      Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([chainId, txHash])
  @@index([chainId, isVisible])
}

model EntityLike {
  id            Int      @id @default(autoincrement())
  entityType    String // 'dashboard' | 'hotpair'
  entityId      Int
  walletAddress String
  count         Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, entityId, walletAddress])
  @@index([entityType, entityId])
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String
}
